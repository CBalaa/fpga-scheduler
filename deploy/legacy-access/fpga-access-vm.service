[Unit]
Description=FPGA scheduler access VM
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%h/.config/fpga-scheduler/access-vm.env
ExecStart=/usr/bin/python3 %h/.local/lib/fpga-scheduler/vm.py start
ExecStop=/usr/bin/python3 %h/.local/lib/fpga-scheduler/vm.py stop
Restart=always
RestartSec=10
TimeoutStopSec=75
UMask=0077
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
